
from "../Headline/Headline.cpx" import {Headline}

export component BlogIntro
{
    title: ?slot
    abstract: ?slot
    imageUri: ?string
    author: ?string
    date: ?string

    /* todo date format from outside Date.format(date, 'd.m.Y')
    * todo allow to omit class={null}? for Headline */
    render <>
        <div class="flex flex-wrap justify-center">
            <div class="text-center lg:w-8/12">
                <Headline tagName="h1" tagStyle="h1" class={null}>{title}</Headline>
                <p>{abstract}</p>
                <p>{date} - {author}</p>
            </div>
        </div>
        {imageUri
            ? <div
                class="bg-cover bg-center max-h-48 h-screen print:h-auto print:!bg-none"
                style={imageUri ? "background-image: url({imageUri});" : null}
            ></div>
            : ""}
    </>
}
