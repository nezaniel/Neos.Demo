from "./DocumentMode.cpx" import { DocumentMode }
from "../JavaScript/JavaScript.cpx" import { JavaScript }
from "../Stylesheet/Stylesheet.cpx" import { Stylesheet }

export component Document {
    title: string
    stylesheets: Stylesheet[]
    headScripts: JavaScript[]
    neosHeaderStuff: slot
    content: slot
    neosBodyStuff: slot
    mode: DocumentMode
    debug: ?string

    render <>
        <html>
            <head>
                <meta charset="UTF-8" />
                <meta name="viewport" content="width=device-width, initial-scale=1" />
                <meta name="format-detection" content="telephone=no" />
                <title>{title}</title>
                {stylesheets}
                {headScripts}
                {neosHeaderStuff}
            </head>
            <body class={match(mode){
                DocumentMode.MODE_FRONTEND -> "wat",
                DocumentMode.MODE_BACKEND -> "neos-backend",
            }}>
                {content}
                {neosBodyStuff}
            </body>
        </html>
    </>
}
