
from "../Alert/Alert.cpx" import {Alert}

export component YouTube
{
    videoId: ?string
    inBackend: boolean

    render videoId
        ? <figure class="aspect-video">
            <iframe
                src="https://www.youtube.com/embed/{videoId}?wmode=transparent"
                width="100%"
                height="100%"
                frameborder="0"
                allowfullscreen
                >
            </iframe>
        </figure>
        : (inBackend
            /** todo translation */
            ? <Alert
                class="aspect-video"
                content="Neos.Demo:NodeTypes.Content.YouTube:error.no.videoid"
            />
            : "")
}
